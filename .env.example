# Chat LLM Key (Free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: OpenRouter API Key (Free key at https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Cohere API Key (https://cohere.com)
COHERE_API_KEY=your_cohere_api_key_here

# Live Google Flights Search Key (SerpApi)
SERPAPI_KEY=your_serpapi_key_here

# Optional: RapidAPI Key for Flight Search Fallback
RAPIDAPI_KEY=your_rapidapi_key_here

# HuggingFace Token (Free token at https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# Optional: Email OTP Transporter Settings (Gmail SMTP Example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
